{
  "info": {
    "name": "FitTrack",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "workoutId", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "metricId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ayraa\",\n  \"email\": \"ayraa@test.com\",\n  \"password\": \"123456\",\n  \"height\": 165\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.environment.set(\"token\", data.token);",
                  "pm.collectionVariables.set(\"userId\", data._id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohan@test.com\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Workouts",
      "item": [
        {
          "name": "Create Workout",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Chest Day\",\n  \"type\": \"strength\",\n  \"duration\": 45,\n  \"caloriesBurned\": 300,\n  \"exercises\": [{ \"name\": \"Bench Press\", \"sets\": 3, \"reps\": 10, \"weight\": 40 }],\n  \"personalRecord\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/workouts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts"]
            }
          }
        },
        {
          "name": "Get All Workouts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workouts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts"]
            }
          }
        },
        {
          "name": "Get One Workout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        },
        {
          "name": "Update Workout",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duration\": 60\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        },
        {
          "name": "Delete Workout",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "Create Plan",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Beginner Strength Plan\",\n  \"description\": \"A 4 week plan to build basic strength\",\n  \"category\": \"strength\",\n  \"durationWeeks\": 4,\n  \"schedule\": [\n    { \"day\": \"Monday\", \"exercises\": [\"Bench Press\", \"Push Ups\"] },\n    { \"day\": \"Wednesday\", \"exercises\": [\"Squats\", \"Lunges\"] }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans"]
            }
          }
        },
        {
          "name": "Get All Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans"]
            }
          }
        },
        {
          "name": "Get One Plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plans/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans", "{{planId}}"]
            }
          }
        },
        {
          "name": "Follow Plan",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plans/{{planId}}/follow",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans", "{{planId}}", "follow"]
            }
          }
        },
        {
          "name": "Search Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plans/search?keyword=strength",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans", "search"],
              "query": [{ "key": "keyword", "value": "strength" }]
            }
          }
        }
      ]
    },
    {
      "name": "Metrics",
      "item": [
        {
          "name": "Add Metric",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 60,\n  \"height\": 165\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics"]
            }
          }
        },
        {
          "name": "Get User Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "user", "{{userId}}"]
            }
          }
        },
        {
          "name": "Upload Progress Photo",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "photo", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/metrics/{{metricId}}/photo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics", "{{metricId}}", "photo"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Analytics Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/summary?period=weekly",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "summary"],
              "query": [{ "key": "period", "value": "weekly" }]
            }
          }
        }
      ]
    }
  ]
}
